{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "qbs-timeline: compile extension",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "qbs-timeline: unit tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": []
    },
    {
      "label": "qbs-timeline: extension host tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "test:extension"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "qbs-timeline: package extension",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": []
    },
    {
      "label": "qbs-timeline: analyze two-qubit example",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "qbstimeline",
        "analyze",
        "--project",
        "examples/two-qubit-entangling/qbstimeline.yml",
        "--out",
        "examples/two-qubit-entangling/.qbs_timeline/qbs_ir.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "qbs-timeline: render two-qubit example",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "qbstimeline",
        "render",
        "--ir",
        "examples/two-qubit-entangling/.qbs_timeline/qbs_ir.json",
        "--out",
        "examples/two-qubit-entangling/.qbs_timeline/index.html"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "qbs-timeline: build two-qubit example",
      "dependsOrder": "sequence",
      "dependsOn": [
        "qbs-timeline: analyze two-qubit example",
        "qbs-timeline: render two-qubit example"
      ],
      "problemMatcher": []
    }
  ]
}
