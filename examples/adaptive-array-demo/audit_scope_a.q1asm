.DEF TRIG_IDX {TRIGGER_INDEX}
.DEF TRIG_WAIT {TRIGGER_TIMEOUT}
.DEF IQ_Q0 {CH_IQ_Q0}
.DEF IQ_Q1 {CH_IQ_Q1}
.DEF IQ_Q2 {CH_IQ_Q2}
.DEF IQ_Q3 {CH_IQ_Q3}
.DEF TRACK_Q0 {CH_TRACK_Q0}
.DEF TRACK_Q1 {CH_TRACK_Q1}
.DEF TRACK_Q2 {CH_TRACK_Q2}
.DEF TRACK_Q3 {CH_TRACK_Q3}
.DEF GRANT_Q0 {CH_GRANT_Q0}
.DEF GRANT_Q1 {CH_GRANT_Q1}
.DEF GRANT_Q2 {CH_GRANT_Q2}
.DEF GRANT_Q3 {CH_GRANT_Q3}
.DEF TELEMETRY {CH_TELEMETRY}
.DEF FAULT {CH_FAULT}
wait_trigger $TRIG_IDX,$TRIG_WAIT
wait 300
set_scope_en 1
upd_param 4
acquire 5,0,80
wait 120
acquire 6,0,80
set_scope_en 0
upd_param 4
set_mrk 1
upd_param 4
play 26,27,56
set_mrk 0
upd_param 4
wait 160
acquire_ttl 7,0,1,48
set_awg_gain 6000,6000
upd_param 4
play 30,31,48
wait 64
acquire 11,0,64
set_freq 61000000
upd_param 4
play 32,33,48
wait 64
acquire 12,0,64
set_ph_delta 800000
upd_param 4
play 34,35,48
wait 64
acquire 13,0,64
set_mrk 1
upd_param 4
play 36,37,48
set_mrk 0
upd_param 4
stop
