.DEF TRIG_IDX {TRIGGER_INDEX}
.DEF TRIG_WAIT {TRIGGER_TIMEOUT}
.DEF IQ_Q0 {CH_IQ_Q0}
.DEF IQ_Q1 {CH_IQ_Q1}
.DEF IQ_Q2 {CH_IQ_Q2}
.DEF IQ_Q3 {CH_IQ_Q3}
.DEF TRACK_Q0 {CH_TRACK_Q0}
.DEF TRACK_Q1 {CH_TRACK_Q1}
.DEF TRACK_Q2 {CH_TRACK_Q2}
.DEF TRACK_Q3 {CH_TRACK_Q3}
.DEF GRANT_Q0 {CH_GRANT_Q0}
.DEF GRANT_Q1 {CH_GRANT_Q1}
.DEF GRANT_Q2 {CH_GRANT_Q2}
.DEF GRANT_Q3 {CH_GRANT_Q3}
.DEF TELEMETRY {CH_TELEMETRY}
.DEF FAULT {CH_FAULT}
wait_trigger $TRIG_IDX,$TRIG_WAIT
wait 340
set_scope_en 1
upd_param 4
acquire 8,0,80
wait 140
acquire 9,0,80
set_scope_en 0
upd_param 4
set_mrk 1
upd_param 4
play 28,29,56
set_mrk 0
upd_param 4
wait 180
acquire_ttl 10,0,1,48
set_awg_gain 5600,5600
upd_param 4
play 38,39,48
wait 72
acquire 14,0,64
set_freq 63000000
upd_param 4
play 40,41,48
wait 72
acquire 15,0,64
set_ph_delta 900000
upd_param 4
play 42,43,48
wait 72
acquire 16,0,64
set_mrk 1
upd_param 4
play 44,45,48
set_mrk 0
upd_param 4
stop
