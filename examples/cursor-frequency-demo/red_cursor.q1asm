    .DEF SHOT_PERIOD        {SHOT_PERIOD}
    .DEF START_ALIGN        {START_ALIGN}
    .DEF TRIGGER_WAIT       {TRIGGER_WAIT}
    .DEF TRACKER_INIT_CENTER {TRACKER_INIT_CENTER}
    .DEF TRACKER_INIT_GAIN  {TRACKER_INIT_GAIN}
    .DEF CURSOR_GAIN_NUMERATOR {CURSOR_GAIN_NUMERATOR}
    .DEF CURSOR_GAIN_SHIFT {CURSOR_GAIN_SHIFT}
    .DEF CURSOR_DUR         {CURSOR_DUR}
    .DEF CURSOR_CENTER_TO_START {CURSOR_CENTER_TO_START}
    .DEF CURSOR_CHANNEL     {CURSOR_CHANNEL}
    .DEF CURSOR_GAIN_CHANNEL {CURSOR_GAIN_CHANNEL}
    .DEF POST_FEEDBACK_WAIT {POST_FEEDBACK_WAIT}
    .DEF WAIT_CHUNK         {WAIT_CHUNK}
    .DEF CURSOR_W           0
    .DEF ZERO               R0

    .DEF CURSOR_CENTER      R1
    .DEF WAIT_FOR_FEEDBACK  R2
    .DEF CURSOR_WAIT        R3
    .DEF TRACKED_GAIN       R4
    .DEF CURSOR_OUTPUT_GAIN R5

    wait_sync 4

    move $TRACKER_INIT_CENTER, $CURSOR_CENTER
    move 0, $ZERO
    move $TRACKER_INIT_GAIN, $TRACKED_GAIN
    nop
    mulu16 $TRACKED_GAIN, $CURSOR_GAIN_NUMERATOR, $CURSOR_OUTPUT_GAIN
    nop
    asr $CURSOR_OUTPUT_GAIN, $CURSOR_GAIN_SHIFT, $CURSOR_OUTPUT_GAIN
    wait $START_ALIGN

shot_loop:
    wait_trigger 1, $TRIGGER_WAIT

    move $CURSOR_CENTER, $CURSOR_WAIT
    nop
    sub $CURSOR_WAIT, $CURSOR_CENTER_TO_START, $CURSOR_WAIT
    nop

    move $SHOT_PERIOD, $WAIT_FOR_FEEDBACK
    nop
    sub $WAIT_FOR_FEEDBACK, $TRIGGER_WAIT, $WAIT_FOR_FEEDBACK
    nop
    sub $WAIT_FOR_FEEDBACK, $CURSOR_WAIT, $WAIT_FOR_FEEDBACK
    nop
    sub $WAIT_FOR_FEEDBACK, $CURSOR_DUR, $WAIT_FOR_FEEDBACK
    nop
    sub $WAIT_FOR_FEEDBACK, $POST_FEEDBACK_WAIT, $WAIT_FOR_FEEDBACK

    wait $CURSOR_WAIT
    set_awg_gain $CURSOR_OUTPUT_GAIN, $ZERO
    play $CURSOR_W, $CURSOR_W, $CURSOR_DUR

    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_CHUNK
    sub $WAIT_FOR_FEEDBACK, $WAIT_CHUNK, $WAIT_FOR_FEEDBACK
    nop
    wait $WAIT_FOR_FEEDBACK
    fb_pop_data $CURSOR_CHANNEL, $CURSOR_CENTER
    fb_pop_data $CURSOR_GAIN_CHANNEL, $TRACKED_GAIN
    nop
    mulu16 $TRACKED_GAIN, $CURSOR_GAIN_NUMERATOR, $CURSOR_OUTPUT_GAIN
    nop
    asr $CURSOR_OUTPUT_GAIN, $CURSOR_GAIN_SHIFT, $CURSOR_OUTPUT_GAIN
    nop

    wait $POST_FEEDBACK_WAIT
    jmp @shot_loop
    nop
