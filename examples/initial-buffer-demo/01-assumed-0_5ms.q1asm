# About 0.5 ms of Q1 work after the first RT packet.
# The initial 1 ms timing reserve is a user assumption, not a measurement.
set_mrk 1
upd_param 4                 # First RT command starts at analytical RT time 0.

move 17857,R0
work: nop
loop R0,@work               # Compact Q1-only loop: about 28 ns per iteration.

set_mrk 0
upd_param 1000              # Expected: no underflow warning.
stop
