# About 1.5 ms of Q1 work after the first RT packet.
# Beyond the assumed 1 ms, but within the unmeasured 2 ms estimate.
set_mrk 1
upd_param 4                 # No artificial RT startup wait is inserted.

move 53571,R0
work: nop
loop R0,@work               # Compact Q1-only loop: about 28 ns per iteration.

set_mrk 0
upd_param 1000              # Expected: informational initial-buffer estimate.
stop
