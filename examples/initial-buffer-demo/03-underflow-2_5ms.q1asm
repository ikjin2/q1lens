# About 2.5 ms of Q1 work after the first RT packet.
# This deliberately exhausts both initial-buffer scenarios.
set_mrk 1
upd_param 4                 # First RT command still starts immediately.

move 89286,R0
work: nop
loop R0,@work               # Compact Q1-only loop: about 28 ns per iteration.

set_mrk 0
upd_param 1000              # Expected: underflow error on this RT command.
stop
