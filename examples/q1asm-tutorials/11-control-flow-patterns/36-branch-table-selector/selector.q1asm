.DEF SELECT R0

wait 256
fb_pop_data 4,$SELECT
nop

jlt $SELECT,1,@case_zero
jlt $SELECT,2,@case_one
jlt $SELECT,3,@case_two
jmp @case_default

case_zero:
set_mrk 1
upd_param 4
play 0,1,24
stop

case_one:
set_mrk 2
upd_param 4
play 2,3,24
stop

case_two:
set_mrk 3
upd_param 4
play 4,5,24
stop

case_default:
set_mrk 0
upd_param 4
play 6,7,24
stop
