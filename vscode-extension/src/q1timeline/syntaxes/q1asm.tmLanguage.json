{
  "name": "Q1ASM",
  "scopeName": "source.q1asm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#templates"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.q1asm",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.q1asm",
          "match": "//.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            }
          }
        },
        {
          "name": "entity.name.label.q1asm",
          "match": "(?<![\\w@$])@[A-Za-z_][A-Za-z0-9_]*(?![\\w@$])"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i)^\\s*(\\.def)\\b(?!\\s*:)(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.q1asm"
            },
            "2": {
              "name": "constant.other.symbol.q1asm"
            }
          }
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(add|and|asl|asr|cmp|illegal|lsl|lsr|move|muls16|muls32|muls32h|muls32l|mulu16|mulu32|mulu32h|mulu32l|nop|not|or|sub|sw_req|test|xor)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "keyword.other.q1.q1asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(ja|jae|jb|jbe|jg|jge|jl|jle|jlt|jmp|jno|jns|jnz|jo|js|jz|loop|stop)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "keyword.control.flow.q1asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(reset_netzero|reset_ph|set_awg_gain|set_awg_offs|set_cond|set_digital|set_freq|set_mrk|set_ph|set_ph_delta|set_scope_en|set_time_ref)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "storage.modifier.latched.q1asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(acquire|acquire_digital|acquire_timetags|acquire_ttl|acquire_weighed|acquire_weighted|latch_rst|play|play_netzero|play_pulse|set_latch_en|upd_param|upd_thres|wait)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "entity.name.function.rt.q1asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(wait_sync|wait_trigger)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "constant.language.sync.q1asm"
            }
          }
        },
        {
          "match": "(?i)^\\s*(?:([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*)?(fb_acq_iq_id|fb_acq_iq_shift|fb_acq_tb_cfg|fb_acq_tb_extra|fb_acq_tb_id|fb_acq_tb_mock|fb_acq_tb_valid|fb_cmd|fb_com_cfg|fb_com_data|fb_com_extra|fb_llp_tags_id|fb_llp_ttls_id|fb_pop_data|fb_pull_data|fb_tdc_tags_id|fb_tdc_tdelta_id)\\b(?!\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.q1asm"
            },
            "2": {
              "name": "string.other.feedback.q1asm"
            }
          }
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.q1asm",
          "match": "(?<![\\w@$])\\$[A-Za-z_][A-Za-z0-9_]*(?![\\w@$])"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.other.register.q1asm",
          "match": "(?i)(?<![\\w@$])R(?:0x[0-9a-f]+|0|[1-9]\\d*)(?![\\w@$])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.q1asm",
          "match": "(?<![\\w@$+.-])-?(?:0[xX][0-9A-Fa-f]+|0|[1-9]\\d*)(?![\\w@$+.-])"
        }
      ]
    },
    "templates": {
      "patterns": [
        {
          "name": "constant.other.placeholder.q1asm",
          "begin": "\\{",
          "end": "\\}|(?=#|$)",
          "patterns": [
            {
              "include": "#templates"
            }
          ]
        }
      ]
    }
  }
}
